# Rust
/target/
**/*.rs.bk
# Cargo.lock is intentionally NOT ignored: chronos-mcp is a long-lived
# application/server binary (v2 wire protocol, MCP server) and reproducibility
# requires pinning transitive dependencies. Library-only sub-crates inherit
# workspace resolution; lockfile drift is bounded by `cargo update --workspace`.
# (H1.1, 2026-09-21)

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environ
.env
.env.*

# Build artifacts
*.d
*.rlib
*.so
*.dylib
*.dll

# Test artifacts (compiled C fixtures)
tests/fixtures/test_add
tests/fixtures/test_segfault

# Architecture specs (internal)
^/specs/

# Profiling
flamegraph.svg
perf.data
perf.data.old
.cognicode/
*.bak

# Python
__pycache__/
*.pyc

# Jcode scratch (per-harness temp dir)
$JCODE_SCRATCH_DIR/

# Jcode runtime state (per-machine scratch, never committed)
.jcode/

# Loose docs artifacts (working drafts; committed when promoted)
docs/*.zip
/.cargo-target/

# otelc compile-time instrumentation build cache (M4-F0/M4G.1 ADR-0007)
.otelc-build/
