//! End-to-end tests for language adapters (Python, Java, Go, Browser/WASM).
//!
//! These tests verify that the adapters can capture traces from real programs
//! and produce events that can be queried via the QueryEngine.
//!
//! # Running these tests
//!
//! For Python tests: ensure `python3` is in PATH.
//! For Java tests: ensure `java` and `javac` are in PATH.
//! For Go tests: ensure `dlv` (Delve) is in PATH.
//! For Browser tests: ensure Chrome/Chromium is installed and `CHRONOS_E2E=1` is set.
//!
//! ```bash
//! # Run all language adapter tests
//! cargo test -p chronos-sandbox --test language_adapters_e2e
//!
//! # Run only Python tests
//! cargo test -p chronos-sandbox --test language_adapters_e2e python
//!
//! # Run with browser tests (requires CHRONOS_E2E=1)
//! CHRONOS_E2E=1 cargo test -p chronos-sandbox --test language_adapters_e2e -- browser
//! ```

use std::path::Path;

// =============================================================================
// PYTHON TESTS
// =============================================================================

mod python_tests {
    use super::*;

    /// PY1: Capture nested Python function calls and verify call stack.
    #[tokio::test]
    async fn test_python_nested_calls_capture() {
        let fixture = Path::new(env!("CARGO_MANIFEST_DIR")).join("programs/python/nested_calls.py");

        if !fixture.exists() {
            eprintln!("SKIP: nested_calls.py not found at {:?}", fixture);
            return;
        }

        // Use PythonSubprocess directly to capture the script
        let mut proc = chronos_python::subprocess::PythonSubprocess::spawn(
            fixture.to_str().unwrap(),
            true, // capture_locals
        )
        .expect("Should be able to spawn python subprocess");

        // Collect events until process exits
        let mut events = Vec::new();
        let mut call_count = 0;
        let mut return_count = 0;

        for _ in 0..500 {
            match proc.next_event().await {
                Ok(Some(event)) => {
                    if event.event == "call" {
                        call_count += 1;
                    } else if event.event == "return" {
                        return_count += 1;
                    }
                    events.push(event);
                }
                Ok(None) => break,
                Err(e) => {
                    eprintln!("Error reading event: {}", e);
                    break;
                }
            }
        }

        println!(
            "✓ Python nested_calls: {} events, {} calls, {} returns",
            events.len(),
            call_count,
            return_count
        );

        // Verify we captured function entry/exit events
        assert!(
            call_count >= 5,
            "Should capture at least 5 function calls (main + 5 levels)"
        );
        assert!(
            return_count >= 5,
            "Should capture at least 5 function returns"
        );

        // Verify we captured some named functions (names may be fully qualified like __main__.main)
        let named_functions: Vec<_> = events.iter().filter(|e| !e.name.is_empty()).collect();
        assert!(!named_functions.is_empty(), "Should capture function names");
    }

    /// PY2: Capture Python exception chain and verify exception events.
    #[tokio::test]
    async fn test_python_exception_chain_capture() {
        let fixture =
            Path::new(env!("CARGO_MANIFEST_DIR")).join("programs/python/exception_chain.py");

        if !fixture.exists() {
            eprintln!("SKIP: exception_chain.py not found at {:?}", fixture);
            return;
        }

        let mut proc =
            chronos_python::subprocess::PythonSubprocess::spawn(fixture.to_str().unwrap(), false)
                .expect("Should be able to spawn python subprocess");

        let mut events = Vec::new();
        let mut exception_count = 0;

        for _ in 0..500 {
            match proc.next_event().await {
                Ok(Some(event)) => {
                    if event.event == "exception" {
                        exception_count += 1;
                    }
                    events.push(event);
                }
                Ok(None) => break,
                Err(e) => {
                    eprintln!("Error reading event: {}", e);
                    break;
                }
            }
        }

        println!(
            "✓ Python exception_chain: {} events, {} exceptions",
            events.len(),
            exception_count
        );

        // Exception chain should produce at least one exception event
        // (Even if the script handles it, we should capture the throw)
        assert!(events.len() > 0, "Should capture at least some events");
    }

    /// PY3: Verify QueryEngine can filter Python events by function name.
    #[test]
    fn test_python_query_engine_filter() {
        use chronos_domain::{EventData, EventType, PythonEventKind, SourceLocation, TraceEvent};
        use chronos_query::QueryEngine;

        // Create sample Python trace events matching the nested_calls pattern
        let events = vec![
            TraceEvent::python_call(1, 1000, 1, "__main__.main", "nested_calls.py", 1),
            TraceEvent::python_call(2, 2000, 1, "level1", "nested_calls.py", 10),
            TraceEvent::python_call(3, 3000, 1, "level2", "nested_calls.py", 15),
            TraceEvent::python_call(4, 4000, 1, "level3", "nested_calls.py", 20),
            TraceEvent::python_return(5, 5000, 1, "level3", "nested_calls.py", 22),
            TraceEvent::python_return(6, 6000, 1, "level2", "nested_calls.py", 17),
        ];

        let engine = QueryEngine::new(events);

        // Query for function entries
        let query = chronos_domain::TraceQuery::new("test-session")
            .event_types(vec![EventType::FunctionEntry]);

        let result = engine.execute(&query);

        assert_eq!(result.events.len(), 4, "Should find 4 function entries");
        println!(
            "✓ QueryEngine filtered to {} Python function entries",
            result.events.len()
        );
    }
}

