// =============================================================================
// BROWSER/WASM TESTS
// =============================================================================

mod browser_tests {
    use super::*;
    use chronos_domain::ProbeBackend;

    /// BR1: Browser probe with WASM detection (requires CHRONOS_E2E=1).
    #[tokio::test]
    async fn test_browser_probe_wasm_detection() {
        // This test requires CHRONOS_E2E=1 and Chrome installed
        if std::env::var("CHRONOS_E2E").is_err() {
            eprintln!("SKIP: CHRONOS_E2E=1 not set");
            return;
        }

        if !chronos_browser::BrowserAdapter::is_chrome_available() {
            eprintln!("SKIP: Chrome not available");
            return;
        }

        let adapter = chronos_browser::BrowserAdapter::new();
        let config = chronos_domain::CaptureConfig::new("data:text/html,<h1>Test</h1>");

        let session = match adapter.start_probe_async(config, true, None).await {
            Ok(s) => s,
            Err(e) => {
                eprintln!("SKIP: Browser probe failed to start: {}", e);
                return;
            }
        };

        // Wait a bit for events to accumulate
        tokio::time::sleep(tokio::time::Duration::from_secs(2)).await;

        // Drain events using ProbeBackend trait
        let raw_events = adapter.drain_raw_events();
        let semantic_events = adapter.drain_events().unwrap_or_default();

        println!(
            "✓ Browser probe: {} raw events, {} semantic events",
            raw_events.len(),
            semantic_events.len()
        );

        // We should have captured some events
        assert!(
            raw_events.len() > 0 || semantic_events.len() > 0,
            "Should capture at least some browser events"
        );
    }

    /// BR2: Verify browser adapter creation.
    #[test]
    fn test_browser_adapter_creation() {
        let adapter = chronos_browser::BrowserAdapter::new();
        let name = adapter.name();
        println!("✓ Browser adapter name: {}", name);
        assert_eq!(name, "browser-wasm");
    }
}

// =============================================================================
// INTEGRATION TESTS
// =============================================================================

/// INT1: Full QueryEngine workflow with Python-like trace events.
/// This test verifies the complete pipeline: capture -> events -> QueryEngine.
#[test]
fn test_query_engine_python_events() {
    use chronos_domain::{EventType, TraceEvent, VariableInfo};
    use chronos_query::QueryEngine;

    // Simulate Python nested calls trace
    let events = vec![
        TraceEvent::python_call_with_locals(
            1,
            1000,
            1,
            "__main__.main",
            "nested_calls.py",
            1,
            vec![VariableInfo::local("n", "100", "int", 0x1000)],
        ),
        TraceEvent::python_call(2, 1500, 1, "level1", "nested_calls.py", 10),
        TraceEvent::python_call(3, 2000, 1, "level2", "nested_calls.py", 15),
        TraceEvent::python_call(4, 2500, 1, "level3", "nested_calls.py", 20),
        TraceEvent::python_call(5, 3000, 1, "level4", "nested_calls.py", 25),
        TraceEvent::python_call(6, 3500, 1, "level5", "nested_calls.py", 30),
        TraceEvent::python_return(7, 4000, 1, "level5", "nested_calls.py", 31),
        TraceEvent::python_return(8, 4500, 1, "level4", "nested_calls.py", 26),
        TraceEvent::python_return(9, 5000, 1, "level3", "nested_calls.py", 21),
        TraceEvent::python_return(10, 5500, 1, "level2", "nested_calls.py", 16),
        TraceEvent::python_return(11, 6000, 1, "level1", "nested_calls.py", 11),
        TraceEvent::python_return(12, 6500, 1, "main", "nested_calls.py", 3),
    ];

    let engine = QueryEngine::new(events);

    // Test 1: Get call stack at level3
    let stack = engine.reconstruct_call_stack(5); // During level4 call
    println!("Call stack at event 5 (level4):");
    for frame in &stack {
        println!("  {}: {}", frame.depth, frame.function);
    }
    assert!(!stack.is_empty(), "Should have non-empty call stack");

    // Test 2: Get variables at a Python call
    let vars = engine.get_variables_at_event(1);
    assert!(!vars.is_empty(), "Should have captured local variables");
    assert_eq!(vars[0].name, "n", "Should have 'n' variable");

    // Test 3: Filter by event type
    let query = chronos_domain::TraceQuery::new("session")
        .event_types(vec![EventType::FunctionEntry, EventType::FunctionExit]);
    let result = engine.execute(&query);
    assert_eq!(
        result.total_matching, 12,
        "Should have 12 call/return events"
    );

    // Test 4: Saliency scores
    let scores = engine.get_saliency_scores(5);
    println!("Top 5 salient functions:");
    for score in &scores {
        println!("  {}: {:.4}", score.function, score.saliency_score);
    }
    assert!(!scores.is_empty(), "Should compute saliency scores");

    println!("✓ QueryEngine Python integration test passed");
}

/// INT2: Test that QueryEngine correctly isolates concurrent sessions.
#[test]
fn test_concurrent_language_sessions() {
    use chronos_domain::{EventType, TraceEvent};
    use chronos_query::QueryEngine;

    // Create two "sessions" worth of events
    let session1_events = vec![
        TraceEvent::python_call(1, 1000, 1, "func_a", "script1.py", 10),
        TraceEvent::python_return(2, 2000, 1, "func_a", "script1.py", 12),
    ];

    let session2_events = vec![
        TraceEvent::python_call(1, 1000, 1, "func_b", "script2.py", 20),
        TraceEvent::python_return(2, 2000, 1, "func_b", "script2.py", 22),
    ];

    let engine1 = QueryEngine::new(session1_events);
    let engine2 = QueryEngine::new(session2_events);

    // Query both engines independently (simulating concurrent sessions)
    let result1 = engine1.execute(&chronos_domain::TraceQuery::new("session1"));
    let result2 = engine2.execute(&chronos_domain::TraceQuery::new("session2"));

    assert_eq!(result1.total_matching, 2, "Session 1 should have 2 events");
    assert_eq!(result2.total_matching, 2, "Session 2 should have 2 events");

    // Verify function names are isolated
    let func1 = result1.events[0].location.function.as_deref();
    let func2 = result2.events[0].location.function.as_deref();

    assert_eq!(func1, Some("func_a"), "Session 1 should have func_a");
    assert_eq!(func2, Some("func_b"), "Session 2 should have func_b");

    println!("✓ Concurrent sessions isolation test passed");
}
